#!/bin/sh
# 🚨
# 🚨 Source: https://netactuate.dl.sourceforge.net/project/wordlist/SCOWL/2020.12.07/scowl-2020.12.07.zip?viasf=1::src/make-abbreviations.lst
# 🚨

comm -23 working/abbreviations.lst.pre      \
         working/proper-names.lst           \
  | sed "s/^\(.*\)/\1 \1's/"  | tr ' ' '\n' \
  | sort -u                                 \
  > working/abbreviations.lst

